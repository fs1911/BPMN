      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${rejected}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="sequenceFlow_17hkj" name="freigegeben" sourceRef="exclusiveGateway_12hkj" targetRef="endEvent_16hkj" />
    <bpmn:sequenceFlow id="sequenceFlow_18hkj" name="nein" sourceRef="exclusiveGateway_whkj" targetRef="userTask_uhkj">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${no}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
