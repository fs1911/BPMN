{
  "name": "flowcraft-bpmn",
  "private": true,
  "version": "1.0.0",
  "description": "FlowCraft \u2014 a production-grade BPMN 2.0 modeling tool with a custom layout/routing engine and AI-assisted process generation.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "smoke:llm": "node scripts/smoke-llm.mjs",
    "bench:layout": "vite-node scripts/bench-layout.ts",
    "smoke:pdf": "node scripts/smoke-pdf.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@bpmn-io/properties-panel": "^3.46.0",
    "bpmn-js": "^17.11.1",
    "bpmn-js-properties-panel": "^5.60.0",
    "fast-xml-parser": "^4.5.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "svg2pdf.js": "^2.8.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^25.0.1",
    "playwright": "^1.61.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
