    <bpmn:exclusiveGateway id="exclusiveGateway_whkj" name="Angaben fehlen?" />
    <bpmn:userTask id="userTask_yhkj" name="Bewertet den Antrag anhand der Vorschriften" />
    <bpmn:userTask id="userTask_10hkj" name="Freigabe erteilen" />
    <bpmn:exclusiveGateway id="exclusiveGateway_12hkj" name="Freigegeben?" />
