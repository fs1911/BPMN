    <bpmn:userTask id="userTask_14zmg" name="Freigabe erteilen" />
    <bpmn:exclusiveGateway id="exclusiveGateway_16zmg" name="Freigegeben?" default="sequenceFlow_19zmg" />
    <bpmn:endEvent id="endEvent_18zmg" name="Anforderung abgelehnt" />
    <bpmn:userTask id="userTask_1azmg" name="Freigabe erteilen" />
    <bpmn:exclusiveGateway id="exclusiveGateway_1czmg" name="Freigegeben?" default="sequenceFlow_1fzmg" />
