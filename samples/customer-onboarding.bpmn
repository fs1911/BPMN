  <bpmn:process id="Process_ai" name="A New Customer Request Is Received" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Process_ai">
      <bpmn:lane id="Lane_17vnu" name="Sales">
        <bpmn:flowNodeRef>startEvent_1cvnv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>userTask_1dvnv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_1fvnv</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_18vnv" name="Compliance Officer">
        <bpmn:flowNodeRef>userTask_1hvnv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exclusiveGateway_1jvnv</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_19vnv" name="Manager">
        <bpmn:flowNodeRef>userTask_1lvnv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exclusiveGateway_1nvnv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endEvent_1pvnv</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1avnv" name="The Customer">
        <bpmn:flowNodeRef>endEvent_1rvnv</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1bvnv" name="System" />
    </bpmn:laneSet>
    <bpmn:startEvent id="startEvent_1cvnv" name="Request received">
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:userTask id="userTask_1dvnv" name="New customer request is received" />
    <bpmn:task id="task_1fvnv" name="Sales agent collects the customer documents" />
    <bpmn:userTask id="userTask_1hvnv" name="Compliance officer checks the documents for KYC" />
    <bpmn:exclusiveGateway id="exclusiveGateway_1jvnv" name="Checks fail?" />
    <bpmn:userTask id="userTask_1lvnv" name="Approve request" />
    <bpmn:exclusiveGateway id="exclusiveGateway_1nvnv" name="Approved?" default="sequenceFlow_1qvnv" />
    <bpmn:endEvent id="endEvent_1pvnv" name="Request rejected" />
    <bpmn:endEvent id="endEvent_1rvnv" name="System creates the customer account and the" />
    <bpmn:sequenceFlow id="sequenceFlow_1evnv" name="" sourceRef="startEvent_1cvnv" targetRef="userTask_1dvnv" />
    <bpmn:sequenceFlow id="sequenceFlow_1gvnv" name="" sourceRef="userTask_1dvnv" targetRef="task_1fvnv" />
    <bpmn:sequenceFlow id="sequenceFlow_1ivnv" name="" sourceRef="task_1fvnv" targetRef="userTask_1hvnv" />
    <bpmn:sequenceFlow id="sequenceFlow_1kvnv" name="" sourceRef="userTask_1hvnv" targetRef="exclusiveGateway_1jvnv" />
    <bpmn:sequenceFlow id="sequenceFlow_1mvnv" name="yes" sourceRef="exclusiveGateway_1jvnv" targetRef="userTask_1lvnv" />
    <bpmn:sequenceFlow id="sequenceFlow_1ovnv" name="" sourceRef="userTask_1lvnv" targetRef="exclusiveGateway_1nvnv" />
    <bpmn:sequenceFlow id="sequenceFlow_1qvnv" name="rejected" sourceRef="exclusiveGateway_1nvnv" targetRef="endEvent_1pvnv">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${rejected}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="sequenceFlow_1svnv" name="approved" sourceRef="exclusiveGateway_1nvnv" targetRef="endEvent_1rvnv" />
    <bpmn:sequenceFlow id="sequenceFlow_1tvnv" name="no" sourceRef="exclusiveGateway_1jvnv" targetRef="userTask_1hvnv">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${no}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
