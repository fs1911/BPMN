    <bpmn:userTask id="userTask_1ufmo" name="Buchhaltung prüft die Unterlagen für KYC" />
    <bpmn:exclusiveGateway id="exclusiveGateway_1wfmo" name="Die Prüfung scheitert?" />
    <bpmn:userTask id="userTask_1yfmo" name="Freigabe erteilen" />
