        <bpmn:flowNodeRef>endEvent_1gzmg</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_uzmg" name="System" />
    </bpmn:laneSet>
    <bpmn:startEvent id="startEvent_vzmg" name="Anforderung eingegangen" />
    <bpmn:userTask id="userTask_wzmg" name="Antragsteller reicht einen Bauantrag über das Portal" />
