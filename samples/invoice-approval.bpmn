<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://flowcraft/bpmn">
  <bpmn:process id="Process_ai" name="When An Invoice Is Received, The" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Process_ai">
      <bpmn:lane id="Lane_1vn3" name="Accountant">
        <bpmn:flowNodeRef>startEvent_4vn3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>userTask_5vn3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exclusiveGateway_7vn4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2vn3" name="Department Head">
        <bpmn:flowNodeRef>userTask_9vn4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exclusiveGateway_bvn4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endEvent_dvn4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endEvent_hvn4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3vn3" name="System">
        <bpmn:flowNodeRef>serviceTask_fvn4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="startEvent_4vn3" name="When an invoice is received, the accountant">
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:userTask id="userTask_5vn3" name="Accountant checks the invoice against the purchase" />
    <bpmn:exclusiveGateway id="exclusiveGateway_7vn4" name="The documents are incomplete?" />
    <bpmn:userTask id="userTask_9vn4" name="Approve request" />
    <bpmn:exclusiveGateway id="exclusiveGateway_bvn4" name="Approved?" default="sequenceFlow_evn4" />
    <bpmn:endEvent id="endEvent_dvn4" name="Request rejected" />
    <bpmn:serviceTask id="serviceTask_fvn4" name="System schedules the payment" />
    <bpmn:endEvent id="endEvent_hvn4" name="Process ends when the payment is archived" />
    <bpmn:sequenceFlow id="sequenceFlow_6vn3" name="" sourceRef="startEvent_4vn3" targetRef="userTask_5vn3" />
    <bpmn:sequenceFlow id="sequenceFlow_8vn4" name="" sourceRef="userTask_5vn3" targetRef="exclusiveGateway_7vn4" />
    <bpmn:sequenceFlow id="sequenceFlow_avn4" name="yes" sourceRef="exclusiveGateway_7vn4" targetRef="userTask_9vn4" />
    <bpmn:sequenceFlow id="sequenceFlow_cvn4" name="" sourceRef="userTask_9vn4" targetRef="exclusiveGateway_bvn4" />
    <bpmn:sequenceFlow id="sequenceFlow_evn4" name="rejected" sourceRef="exclusiveGateway_bvn4" targetRef="endEvent_dvn4">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${rejected}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="sequenceFlow_gvn4" name="approved" sourceRef="exclusiveGateway_bvn4" targetRef="serviceTask_fvn4" />
    <bpmn:sequenceFlow id="sequenceFlow_ivn4" name="" sourceRef="serviceTask_fvn4" targetRef="endEvent_hvn4" />
    <bpmn:sequenceFlow id="sequenceFlow_jvn4" name="no" sourceRef="exclusiveGateway_7vn4" targetRef="userTask_5vn3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${no}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_ai">
      <bpmndi:BPMNShape id="Lane_1vn3_di" bpmnElement="Lane_1vn3" isHorizontal="true">
