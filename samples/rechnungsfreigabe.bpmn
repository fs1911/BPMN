  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1fn4" name="Prozess" processRef="Process_ai" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ai" name="Erfasst Der Sachbearbeiter Sie" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Process_ai">
      <bpmn:lane id="Lane_2fn4" name="Sachbearbeiter">
        <bpmn:flowNodeRef>startEvent_5fn5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>userTask_6fn5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exclusiveGateway_8fn5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3fn4" name="Abteilungsleiter">
        <bpmn:flowNodeRef>userTask_afn5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exclusiveGateway_cfn5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endEvent_efn5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exclusiveGateway_ifn5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endEvent_kfn5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endEvent_mfn6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_4fn4" name="System">
        <bpmn:flowNodeRef>serviceTask_gfn5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="startEvent_5fn5" name="Wenn eine Rechnung eingeht, erfasst der Sachbearbeiter" />
    <bpmn:userTask id="userTask_6fn5" name="Sachbearbeiter prüft die Rechnung gegen die Bestellung" />
    <bpmn:exclusiveGateway id="exclusiveGateway_8fn5" name="Die Unterlagen unvollständig sind?" />
    <bpmn:userTask id="userTask_afn5" name="Freigabe erteilen" />
    <bpmn:exclusiveGateway id="exclusiveGateway_cfn5" name="Freigegeben?" default="sequenceFlow_ffn5" />
    <bpmn:endEvent id="endEvent_efn5" name="Anforderung abgelehnt" />
    <bpmn:serviceTask id="serviceTask_gfn5" name="System plant die Zahlung" />
    <bpmn:exclusiveGateway id="exclusiveGateway_ifn5" name="Die Zahlung archiviert ist?" default="sequenceFlow_lfn6" />
    <bpmn:endEvent id="endEvent_kfn5" name="Gestoppt" />
    <bpmn:endEvent id="endEvent_mfn6" name="Prozess abgeschlossen" />
    <bpmn:sequenceFlow id="sequenceFlow_7fn5" name="" sourceRef="startEvent_5fn5" targetRef="userTask_6fn5" />
    <bpmn:sequenceFlow id="sequenceFlow_9fn5" name="" sourceRef="userTask_6fn5" targetRef="exclusiveGateway_8fn5" />
    <bpmn:sequenceFlow id="sequenceFlow_bfn5" name="ja" sourceRef="exclusiveGateway_8fn5" targetRef="userTask_afn5" />
    <bpmn:sequenceFlow id="sequenceFlow_dfn5" name="" sourceRef="userTask_afn5" targetRef="exclusiveGateway_cfn5" />
    <bpmn:sequenceFlow id="sequenceFlow_ffn5" name="abgelehnt" sourceRef="exclusiveGateway_cfn5" targetRef="endEvent_efn5">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${rejected}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="sequenceFlow_hfn5" name="freigegeben" sourceRef="exclusiveGateway_cfn5" targetRef="serviceTask_gfn5" />
    <bpmn:sequenceFlow id="sequenceFlow_jfn5" name="" sourceRef="serviceTask_gfn5" targetRef="exclusiveGateway_ifn5" />
    <bpmn:sequenceFlow id="sequenceFlow_lfn6" name="nein" sourceRef="exclusiveGateway_ifn5" targetRef="endEvent_kfn5">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${no}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="sequenceFlow_nfn6" name="ja" sourceRef="exclusiveGateway_ifn5" targetRef="endEvent_mfn6" />
    <bpmn:sequenceFlow id="sequenceFlow_ofn6" name="nein" sourceRef="exclusiveGateway_8fn5" targetRef="userTask_6fn5">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${no}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
