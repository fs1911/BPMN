    <bpmn:userTask id="userTask_14fnm" name="Freigabe erteilen" />
    <bpmn:exclusiveGateway id="exclusiveGateway_16fnm" name="Freigegeben?" default="sequenceFlow_19fnm" />
    <bpmn:endEvent id="endEvent_18fnm" name="Anforderung abgelehnt" />
    <bpmn:userTask id="userTask_1afnm" name="Freigabe erteilen" />
