      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${rejected}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="sequenceFlow_25fmo" name="freigegeben" sourceRef="exclusiveGateway_20fmo" targetRef="endEvent_24fmo" />
    <bpmn:sequenceFlow id="sequenceFlow_26fmo" name="nein" sourceRef="exclusiveGateway_1wfmo" targetRef="userTask_1ufmo">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${no}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
