      <bpmn:lane id="Lane_mhki" name="Antragsteller">
        <bpmn:flowNodeRef>startEvent_rhki</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>userTask_shki</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exclusiveGateway_whkj</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_nhki" name="Sachbearbeiter">
        <bpmn:flowNodeRef>userTask_uhkj</bpmn:flowNodeRef>
      </bpmn:lane>
