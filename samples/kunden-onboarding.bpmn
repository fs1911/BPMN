    <bpmn:laneSet id="LaneSet_Process_ai">
      <bpmn:lane id="Lane_1kfmo" name="Neue Kunde">
        <bpmn:flowNodeRef>startEvent_1pfmo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>userTask_1qfmo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1lfmo" name="Kunde">
        <bpmn:flowNodeRef>userTask_1sfmo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endEvent_24fmo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1mfmo" name="Buchhaltung">
        <bpmn:flowNodeRef>userTask_1ufmo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exclusiveGateway_1wfmo</bpmn:flowNodeRef>
      </bpmn:lane>
