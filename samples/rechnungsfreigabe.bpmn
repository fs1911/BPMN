  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1fl9" name="Prozess" processRef="Process_ai" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ai" name="Erfasst Der Sachbearbeiter Sie" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Process_ai">
      <bpmn:lane id="Lane_2fl9" name="Sachbearbeiter">
        <bpmn:flowNodeRef>startEvent_5fl9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>userTask_6fl9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exclusiveGateway_8fla</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3fl9" name="Abteilungsleiter">
        <bpmn:flowNodeRef>userTask_afla</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exclusiveGateway_cfla</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endEvent_efla</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exclusiveGateway_ifla</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endEvent_kfla</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endEvent_mfla</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_4fl9" name="System">
        <bpmn:flowNodeRef>serviceTask_gfla</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="startEvent_5fl9" name="Wenn eine Rechnung eingeht, erfasst der Sachbearbeiter" />
    <bpmn:userTask id="userTask_6fl9" name="Sachbearbeiter prüft die Rechnung gegen die Bestellung" />
    <bpmn:exclusiveGateway id="exclusiveGateway_8fla" name="Die Unterlagen unvollständig sind?" />
    <bpmn:userTask id="userTask_afla" name="Freigabe erteilen" />
    <bpmn:exclusiveGateway id="exclusiveGateway_cfla" name="Freigegeben?" default="sequenceFlow_ffla" />
    <bpmn:endEvent id="endEvent_efla" name="Anforderung abgelehnt" />
    <bpmn:serviceTask id="serviceTask_gfla" name="System plant die Zahlung" />
    <bpmn:exclusiveGateway id="exclusiveGateway_ifla" name="Die Zahlung archiviert ist?" default="sequenceFlow_lfla" />
    <bpmn:endEvent id="endEvent_kfla" name="Gestoppt" />
    <bpmn:endEvent id="endEvent_mfla" name="Prozess abgeschlossen" />
    <bpmn:sequenceFlow id="sequenceFlow_7fla" name="" sourceRef="startEvent_5fl9" targetRef="userTask_6fl9" />
    <bpmn:sequenceFlow id="sequenceFlow_9fla" name="" sourceRef="userTask_6fl9" targetRef="exclusiveGateway_8fla" />
    <bpmn:sequenceFlow id="sequenceFlow_bfla" name="ja" sourceRef="exclusiveGateway_8fla" targetRef="userTask_afla" />
    <bpmn:sequenceFlow id="sequenceFlow_dfla" name="" sourceRef="userTask_afla" targetRef="exclusiveGateway_cfla" />
    <bpmn:sequenceFlow id="sequenceFlow_ffla" name="abgelehnt" sourceRef="exclusiveGateway_cfla" targetRef="endEvent_efla">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${rejected}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="sequenceFlow_hfla" name="freigegeben" sourceRef="exclusiveGateway_cfla" targetRef="serviceTask_gfla" />
    <bpmn:sequenceFlow id="sequenceFlow_jfla" name="" sourceRef="serviceTask_gfla" targetRef="exclusiveGateway_ifla" />
    <bpmn:sequenceFlow id="sequenceFlow_lfla" name="nein" sourceRef="exclusiveGateway_ifla" targetRef="endEvent_kfla">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${no}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="sequenceFlow_nfla" name="ja" sourceRef="exclusiveGateway_ifla" targetRef="endEvent_mfla" />
    <bpmn:sequenceFlow id="sequenceFlow_ofla" name="nein" sourceRef="exclusiveGateway_8fla" targetRef="userTask_6fl9">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${no}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
