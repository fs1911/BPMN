  <bpmn:process id="Process_ai" name="Der Antragsteller Reicht Einen Bauantrag üBer" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Process_ai">
      <bpmn:lane id="Lane_pzmg" name="Der Antragsteller">
        <bpmn:flowNodeRef>startEvent_vzmg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>userTask_wzmg</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_qzmg" name="Sachbearbeiter">
        <bpmn:flowNodeRef>userTask_yzmg</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_rzmg" name="Den Antragsteller">
