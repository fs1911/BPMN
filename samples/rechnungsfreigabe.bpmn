  <bpmn:process id="Process_ai" name="Wenn Eine Rechnung Eingeht, Erfasst Der" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Process_ai">
      <bpmn:lane id="Lane_1zly" name="Der Sachbearbeiter">
        <bpmn:flowNodeRef>startEvent_5zlz</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2zlz" name="Sachbearbeiter">
        <bpmn:flowNodeRef>userTask_6zlz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exclusiveGateway_8zlz</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3zlz" name="Abteilungsleiter">
        <bpmn:flowNodeRef>userTask_azlz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exclusiveGateway_czlz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endEvent_ezlz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exclusiveGateway_izlz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endEvent_kzlz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endEvent_mzlz</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_4zlz" name="System">
        <bpmn:flowNodeRef>serviceTask_gzlz</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="startEvent_5zlz" name="Wenn eine Rechnung eingeht, erfasst der Sachbearbeiter" />
    <bpmn:userTask id="userTask_6zlz" name="Sachbearbeiter prüft die Rechnung gegen die Bestellung" />
    <bpmn:exclusiveGateway id="exclusiveGateway_8zlz" name="Die Unterlagen unvollständig sind?" />
    <bpmn:userTask id="userTask_azlz" name="Freigabe erteilen" />
    <bpmn:exclusiveGateway id="exclusiveGateway_czlz" name="Freigegeben?" default="sequenceFlow_fzlz" />
    <bpmn:endEvent id="endEvent_ezlz" name="Anforderung abgelehnt" />
    <bpmn:serviceTask id="serviceTask_gzlz" name="System plant die Zahlung" />
    <bpmn:exclusiveGateway id="exclusiveGateway_izlz" name="Die Zahlung archiviert ist?" default="sequenceFlow_lzlz" />
    <bpmn:endEvent id="endEvent_kzlz" name="Gestoppt" />
    <bpmn:endEvent id="endEvent_mzlz" name="Prozess abgeschlossen" />
    <bpmn:sequenceFlow id="sequenceFlow_7zlz" name="" sourceRef="startEvent_5zlz" targetRef="userTask_6zlz" />
    <bpmn:sequenceFlow id="sequenceFlow_9zlz" name="" sourceRef="userTask_6zlz" targetRef="exclusiveGateway_8zlz" />
    <bpmn:sequenceFlow id="sequenceFlow_bzlz" name="ja" sourceRef="exclusiveGateway_8zlz" targetRef="userTask_azlz" />
    <bpmn:sequenceFlow id="sequenceFlow_dzlz" name="" sourceRef="userTask_azlz" targetRef="exclusiveGateway_czlz" />
    <bpmn:sequenceFlow id="sequenceFlow_fzlz" name="abgelehnt" sourceRef="exclusiveGateway_czlz" targetRef="endEvent_ezlz">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${rejected}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="sequenceFlow_hzlz" name="freigegeben" sourceRef="exclusiveGateway_czlz" targetRef="serviceTask_gzlz" />
    <bpmn:sequenceFlow id="sequenceFlow_jzlz" name="" sourceRef="serviceTask_gzlz" targetRef="exclusiveGateway_izlz" />
    <bpmn:sequenceFlow id="sequenceFlow_lzlz" name="nein" sourceRef="exclusiveGateway_izlz" targetRef="endEvent_kzlz">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${no}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="sequenceFlow_nzlz" name="ja" sourceRef="exclusiveGateway_izlz" targetRef="endEvent_mzlz" />
    <bpmn:sequenceFlow id="sequenceFlow_ozlz" name="nein" sourceRef="exclusiveGateway_8zlz" targetRef="userTask_6zlz">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${no}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
